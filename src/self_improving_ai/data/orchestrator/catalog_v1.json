    {
      "name": "portfolio_estimation_agent",
      "description": "Component A. Numeric portfolio analysis for one client. Set task to one of: risk_return, goal_projection, drift, tax_impact, tax_loss_harvest, income, fee_drag, rate_shock, currency_shock, allocation_vs_risk.",
      "params": [
        {
          "name": "client_id",
          "type": "string",
          "description": "Client ID"
        },
        {
          "name": "task",
          "type": "string",
          "description": "Analysis type (see description)"
        },
        {
          "name": "shock_bps",
          "type": "integer",
          "description": "For rate_shock: size in basis points (25 = 0.25%)"
        },
        {
          "name": "currency_pair",
          "type": "string",
          "description": "For currency_shock, e.g. EUR/USD"
        },
        {
          "name": "goal_amount",
          "type": "number",
          "description": "For goal_projection: target in dollars"
        },
        {
          "name": "tickers",
          "type": "string",
          "description": "Optional comma-separated tickers to focus on"
        }
      ],
      "returns": "Structured numeric result with assumptions and coverage",
      "status": "active",
      "callable_by": [
        "request_orchestrator"
      ],
      "capability": "portfolio_analysis"
    },
