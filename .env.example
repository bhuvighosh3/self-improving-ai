# Google Cloud / Gemini
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
SIA_GOOGLE_CLOUD_PROJECT=your-gcp-project-id  # Firestore calendar events

# Optional independent Component A Developer API configuration.
# These settings do not replace B/C model selection or Vertex AI configuration.
SIA_PORTFOLIO_MODEL=gemini-3.5-flash-lite
# Leave this line commented to inherit GOOGLE_API_KEY / GEMINI_API_KEY.
# SIA_PORTFOLIO_API_KEY=
TWELVE_DATA_API_KEY=

# OpenTelemetry
OTEL_SERVICE_NAME=self-improving-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Dashboard
FASTAPI_PORT=8000
REACT_APP_API_URL=http://localhost:8000
