# Google Cloud / Gemini
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Calendar and Inbox use the same explicit storage backend.
# local: persisted demo records in SIA_DB_PATH; no cloud login required.
# firestore: requires the team's project and Application Default Credentials.
SIA_WORKSPACE_STORE=local
SIA_GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-credentials.json
# Shared B/C defaults: gemini-3.8-flash; provider-503 alternative: gemini-3.5-flash-lite.
# SIA_AGENT_MODEL=gemini-3.8-flash
# SIA_AGENT_MODEL_FALLBACK=gemini-3.5-flash-lite
# SIA_BRIEFING_NEWS_SOURCE=auto

# Optional independent Component A Developer API configuration.
# These settings do not replace B/C model selection or Vertex AI configuration.
SIA_PORTFOLIO_MODEL=gemini-3.5-flash-lite
# Leave this line commented to inherit GOOGLE_API_KEY / GEMINI_API_KEY.
# SIA_PORTFOLIO_API_KEY=
TWELVE_DATA_API_KEY=

# OpenTelemetry
OTEL_SERVICE_NAME=self-improving-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Dashboard
FASTAPI_PORT=8000
REACT_APP_API_URL=http://localhost:8000
